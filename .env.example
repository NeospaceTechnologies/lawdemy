# PostgreSQL. For local dev run `npm run db:local` (embedded Postgres on :5432, UTF-8, data in .pgdata).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/lawdemy?sslmode=disable"
# Direct (non-pooled) connection for migrations. Locally it matches DATABASE_URL; on Supabase use the session pooler (port 5432).
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/lawdemy?sslmode=disable"
# Base URL used in emailed links and provider callbacks.
APP_URL="http://localhost:3000"

# Email: "console" prints emails (with links) to the server log. Add the chosen provider in src/lib/email.
EMAIL_PROVIDER="console"
# Media storage: "local" writes to ./uploads. Swap for an S3 + video-host adapter in src/lib/storage.
STORAGE_DRIVER="local"
# Payments, bank lookup and payouts: "mock" runs the whole flow locally. Add Flutterwave/Paystack in src/lib/payments.
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="change-me"
# 32 random bytes, base64. Encrypts bank account numbers and staff 2FA secrets at rest. Required in production.
BANK_ENC_KEY=""
# Bearer token for the nightly reconciliation job: GET /api/cron/reconcile (ADM-06).
CRON_SECRET=""

# Business values the PRD leaves open (section 13). Defaults live in src/lib/config.ts.
# PLATFORM_FEE_PCT=20
# PENDING_DAYS=7
# WITHDRAWAL_FEE_KOBO=2000
# QUIZ_PASS_PCT=70
# Withdrawals above this (kobo) wait for staff approval. Default ₦500,000.
# WITHDRAWAL_APPROVAL_KOBO=50000000

# Support contact details shown on the Support pages (placeholders until provided).
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_SUPPORT_ADDRESS=
